---
interface FAQItem {
  q: string;
  a: string;
}
interface Props {
  items: FAQItem[];
}
const { items } = Astro.props;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((it) => ({
    '@type': 'Question',
    name: it.q,
    acceptedAnswer: { '@type': 'Answer', text: it.a },
  })),
};
---
<section class="faq" aria-label="FAQ">
  <h2>FAQ</h2>
  <dl>
    {items.map((it) => (
      <>
        <dt>{it.q}</dt>
        <dd>{it.a}</dd>
      </>
    ))}
  </dl>
</section>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<style>
  .faq { margin: 2rem 0; }
  .faq dt { font-weight: 600; margin-top: 1rem; }
  .faq dd { margin-left: 1rem; color: #333; }
</style>
