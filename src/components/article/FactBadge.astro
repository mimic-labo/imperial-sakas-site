---
interface Props {
  type: 'primary' | 'secondary' | 'analysis' | 'unverified';
}
const { type } = Astro.props;
const label = {
  primary: '一次情報',
  secondary: '二次情報',
  analysis: '独自分析',
  unverified: '要検証',
}[type];
---
<span class={`fact-badge fact-${type}`} title={label}>{label}</span>
<style>
  .fact-badge {
    display: inline-block;
    font-size: 0.75rem;
    padding: 0.1rem 0.5rem;
    border-radius: 3px;
    margin: 0 0.25rem;
    font-weight: 500;
  }
  .fact-primary { background: #e8f5e9; color: #2e7d32; }
  .fact-secondary { background: #fff3e0; color: #ef6c00; }
  .fact-analysis { background: #e3f2fd; color: #1565c0; }
  .fact-unverified { background: #ffebee; color: #c62828; }
</style>
